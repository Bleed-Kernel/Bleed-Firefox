+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GFX_PLATFORM_BLEED_H
+#define GFX_PLATFORM_BLEED_H
+
+#include "gfxPlatform.h"
+
+// bleed: everything in software, fonts through the in tree freetype from
+// /usr/share/fonts like android does with /system/fonts
+class gfxBleedPlatform final : public gfxPlatform {
+ public:
+  gfxBleedPlatform();
+  virtual ~gfxBleedPlatform();
+
+  static gfxBleedPlatform* GetPlatform() {
+    return (gfxBleedPlatform*)gfxPlatform::GetPlatform();
+  }
+
+  already_AddRefed<gfxASurface> CreateOffscreenSurface(
+      const IntSize& aSize, gfxImageFormat aFormat) override;
+
+  bool CreatePlatformFontList() override;
+  void ReadSystemFontList(mozilla::dom::SystemFontList*) override;
+
+  void GetCommonFallbackFonts(uint32_t aCh, Script aRunScript,
+                              FontPresentation aPresentation,
+                              nsTArray<const char*>& aFontList) override;
+
+  bool FontHintingEnabled() override { return true; }
+  bool RequiresLinearZoom() override { return false; }
+
+  already_AddRefed<mozilla::gfx::VsyncSource> CreateGlobalHardwareVsyncSource()
+      override;
+
+  static bool CheckVariationFontSupport() { return true; }
+
+ protected:
+  bool AccelerateLayersByDefault() override { return false; }
+};
+
+#endif  // GFX_PLATFORM_BLEED_H
