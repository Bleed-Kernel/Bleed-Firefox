+++ b/media/libcubeb/src/cubeb_bleed.c
@@ -0,0 +1,619 @@
+/*
+ * Copyright © 2026 Bleed Kernel
+ *
+ * This program is made available under an ISC-style license.  See the
+ * accompanying file LICENSE for details.
+ */
+
+/* the bleed backend. every stream opens /dev/audio0 and gets its own stream on the card, the
+ * kernel mixes them. a thread keeps a little audio queued ahead of the hardware: it asks the
+ * data callback for frames (through the resampler when firefox wants another rate), turns them
+ * into the cards s16 stereo with the volume on, writes them straight into the mapped ring and
+ * commits, then sleeps till the card finishes a period. output only, theres no recording yet */
+
+#include "cubeb-internal.h"
+#include "cubeb/cubeb.h"
+#include "cubeb_resampler.h"
+#include "cubeb_tracing.h"
+#include <bleed/audio.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#define BLEED_DEVICE "/dev/audio0"
+
+/* how far ahead of the hardware the stream is kept. it starts at the floor and each time
+ * the card runs dry it grows a bit, emulators deliver the dma in lumps */
+#define BLEED_LEAD_MIN_MS 60
+#define BLEED_LEAD_MAX_MS 250
+#define BLEED_LEAD_XRUN_MS 10
+
+/* the most frames asked of the callback at once */
+#define BLEED_CHUNK_FRAMES 1024
+
+static struct cubeb_ops const bleed_ops;
+
+struct cubeb {
+  struct cubeb_ops const * ops;
+  struct audio_info info; /* what the card does, read once */
+};
+
+struct cubeb_stream {
+  /* Note: Must match cubeb_stream layout in cubeb.c. */
+  cubeb * context;
+  void * user_ptr;
+  /**/
+  cubeb_data_callback data_callback;
+  cubeb_state_callback state_callback;
+  cubeb_resampler * resampler;
+
+  int fd;
+  uint8_t * ring; /* the cards ring for this stream, mapped by ACQUIRE */
+  struct audio_info info;
+  cubeb_stream_params params; /* what firefox asked for */
+
+  pthread_t thread;
+  bool thread_running;
+  pthread_mutex_t mutex; /* guards everything below */
+  bool active;           /* started and not stopped */
+  bool card_running;     /* START was sent since the last STOP */
+  float volume;
+
+  /* positions are bytes since the last START on the card, so the frames from before a stop
+   * are kept here, in the streams own rate */
+  uint64_t base_frames;
+  uint64_t written;   /* bytes committed since START, the kernels write_pos */
+  uint64_t hw_pos;    /* bytes the card has played of it, as of the last look */
+  uint64_t underruns;
+  uint64_t lead;      /* bytes to keep queued */
+
+  void * chunk; /* what the callback fills, in the streams format and channels */
+};
+
+static uint64_t
+ms_bytes(struct audio_info const * info, uint32_t ms)
+{
+  return (uint64_t)ms * info->rate / 1000 * info->frame_bytes;
+}
+
+static size_t
+sample_bytes(cubeb_sample_format format)
+{
+  return format == CUBEB_SAMPLE_FLOAT32NE ? sizeof(float) : sizeof(int16_t);
+}
+
+static int
+bleed_card_info(struct audio_info * info)
+{
+  int fd = open(BLEED_DEVICE, O_WRONLY);
+  if (fd < 0) {
+    return -1;
+  }
+  int r = ioctl(fd, AUDIO_IOC_GET_INFO, info);
+  close(fd);
+  /* the card is always s16 stereo, anything else isnt a card we know */
+  if (r < 0 || info->format != AUDIO_FORMAT_S16LE || info->channels != 2 ||
+      !info->rate || !info->frame_bytes) {
+    return -1;
+  }
+  return 0;
+}
+
+/* card frames to frames in the streams own rate */
+static uint64_t
+to_stream_frames(cubeb_stream * stm, uint64_t card_frames)
+{
+  if (stm->params.rate == stm->info.rate) {
+    return card_frames;
+  }
+  return card_frames * stm->params.rate / stm->info.rate;
+}
+
+static int16_t
+clip16(float s)
+{
+  float v = s * 32767.0f;
+  if (v > 32767.0f) {
+    return 32767;
+  }
+  if (v < -32768.0f) {
+    return -32768;
+  }
+  return (int16_t)v;
+}
+
+/* frames of the streams format into the cards s16 stereo at out */
+static void
+convert(cubeb_stream * stm, int16_t * out, long frames, float volume)
+{
+  uint32_t ch = stm->params.channels;
+  if (stm->params.format == CUBEB_SAMPLE_FLOAT32NE) {
+    float const * in = stm->chunk;
+    for (long i = 0; i < frames; i++) {
+      float l = in[i * ch] * volume;
+      float r = ch > 1 ? in[i * ch + 1] * volume : l;
+      out[i * 2] = clip16(l);
+      out[i * 2 + 1] = clip16(r);
+    }
+  } else {
+    int16_t const * in = stm->chunk;
+    for (long i = 0; i < frames; i++) {
+      int16_t l = (int16_t)(in[i * ch] * volume);
+      int16_t r = ch > 1 ? (int16_t)(in[i * ch + 1] * volume) : l;
+      out[i * 2] = l;
+      out[i * 2 + 1] = r;
+    }
+  }
+}
+
+/* the ring wraps, a write that runs off the end carries on at the start */
+static void
+ring_put(cubeb_stream * stm, uint64_t at, int16_t const * src, uint64_t bytes)
+{
+  uint64_t off = at % stm->info.ring_bytes;
+  uint64_t first = stm->info.ring_bytes - off;
+  if (first > bytes) {
+    first = bytes;
+  }
+  memcpy(stm->ring + off, src, first);
+  if (bytes > first) {
+    memcpy(stm->ring, (uint8_t const *)src + first, bytes - first);
+  }
+}
+
+/* asks the callback for up to want card bytes and commits them. 0 for more to come, 1 once
+ * the callback said it was done, -1 for an error */
+static int
+fill(cubeb_stream * stm, uint64_t want)
+{
+  int16_t out[BLEED_CHUNK_FRAMES * 2];
+  uint64_t fb = stm->info.frame_bytes;
+
+  while (want >= fb) {
+    long frames = (long)(want / fb);
+    if (frames > BLEED_CHUNK_FRAMES) {
+      frames = BLEED_CHUNK_FRAMES;
+    }
+
+    float volume = stm->volume;
+    pthread_mutex_unlock(&stm->mutex);
+    long got = cubeb_resampler_fill(stm->resampler, NULL, NULL, stm->chunk, frames);
+    pthread_mutex_lock(&stm->mutex);
+    if (got < 0 || got > frames) {
+      return -1;
+    }
+
+    convert(stm, out, got, volume);
+    uint64_t bytes = (uint64_t)got * fb;
+    ring_put(stm, stm->written, out, bytes);
+    /* the kernel can take less than asked if the ring is fuller than it looked */
+    uint64_t took = bytes;
+    if (bytes && ioctl(stm->fd, AUDIO_IOC_COMMIT, &took) < 0) {
+      return -1;
+    }
+    stm->written += took;
+    want -= bytes;
+
+    if (got < frames) {
+      return 1;
+    }
+  }
+  return 0;
+}
+
+static void *
+bleed_thread(void * arg)
+{
+  cubeb_stream * stm = arg;
+  int state = CUBEB_STATE_STOPPED;
+  bool draining = false;
+
+  CUBEB_REGISTER_THREAD("cubeb rendering thread");
+  stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_STARTED);
+
+  pthread_mutex_lock(&stm->mutex);
+  for (;;) {
+    if (!stm->active) {
+      state = CUBEB_STATE_STOPPED;
+      break;
+    }
+
+    struct audio_pos pos;
+    if (ioctl(stm->fd, AUDIO_IOC_GET_POS, &pos) < 0) {
+      state = CUBEB_STATE_ERROR;
+      break;
+    }
+    /* the kernel keeps count of what was written, its position is where the next goes */
+    stm->written = pos.write_pos;
+    stm->hw_pos = pos.hw_pos < stm->written ? pos.hw_pos : stm->written;
+
+    /* ran dry, it needs to be further ahead from now on */
+    if (pos.underruns != stm->underruns) {
+      stm->underruns = pos.underruns;
+      uint64_t hi = ms_bytes(&stm->info, BLEED_LEAD_MAX_MS);
+      stm->lead += ms_bytes(&stm->info, BLEED_LEAD_XRUN_MS);
+      if (stm->lead > hi) {
+        stm->lead = hi;
+      }
+    }
+
+    if (draining) {
+      /* everything the callback gave has been heard */
+      if (stm->hw_pos >= stm->written) {
+        state = CUBEB_STATE_DRAINED;
+        break;
+      }
+    } else {
+      uint64_t queued = stm->written - stm->hw_pos;
+      if (queued < stm->lead) {
+        uint64_t want = stm->lead - queued;
+        if (want > pos.writable) {
+          want = pos.writable;
+        }
+        want -= want % stm->info.frame_bytes;
+        int r = fill(stm, want);
+        if (r < 0) {
+          state = CUBEB_STATE_ERROR;
+          break;
+        }
+        draining = r == 1;
+      }
+
+      /* the card starts once theres something on it */
+      if (!stm->card_running && stm->written) {
+        if (ioctl(stm->fd, AUDIO_IOC_START, NULL) < 0) {
+          state = CUBEB_STATE_ERROR;
+          break;
+        }
+        stm->card_running = true;
+      }
+    }
+
+    pthread_mutex_unlock(&stm->mutex);
+    ioctl(stm->fd, AUDIO_IOC_WAIT, NULL);
+    pthread_mutex_lock(&stm->mutex);
+  }
+  pthread_mutex_unlock(&stm->mutex);
+
+  /* stop asks for STOPPED itself, it already knows */
+  if (state != CUBEB_STATE_STOPPED) {
+    stm->state_callback(stm, stm->user_ptr, state);
+  }
+  CUBEB_UNREGISTER_THREAD();
+  return NULL;
+}
+
+int
+bleed_init(cubeb ** context, char const * context_name)
+{
+  (void)context_name;
+  struct audio_info info;
+  if (bleed_card_info(&info) < 0) {
+    return CUBEB_ERROR;
+  }
+
+  cubeb * ctx = calloc(1, sizeof(*ctx));
+  if (!ctx) {
+    return CUBEB_ERROR;
+  }
+  ctx->ops = &bleed_ops;
+  ctx->info = info;
+  *context = ctx;
+  return CUBEB_OK;
+}
+
+static char const *
+bleed_get_backend_id(cubeb * context)
+{
+  (void)context;
+  return "bleed";
+}
+
+static void
+bleed_destroy(cubeb * context)
+{
+  free(context);
+}
+
+static int
+bleed_get_max_channel_count(cubeb * context, uint32_t * max_channels)
+{
+  (void)context;
+  *max_channels = 2;
+  return CUBEB_OK;
+}
+
+static int
+bleed_get_preferred_sample_rate(cubeb * context, uint32_t * rate)
+{
+  *rate = context->info.rate;
+  return CUBEB_OK;
+}
+
+static int
+bleed_get_min_latency(cubeb * context, cubeb_stream_params params,
+                      uint32_t * latency_frames)
+{
+  (void)params;
+  *latency_frames = (uint32_t)(ms_bytes(&context->info, BLEED_LEAD_MIN_MS) /
+                               context->info.frame_bytes);
+  return CUBEB_OK;
+}
+
+static int
+bleed_enumerate_devices(cubeb * context, cubeb_device_type type,
+                        cubeb_device_collection * collection)
+{
+  static char name[] = "Bleed audio";
+  collection->device = NULL;
+  collection->count = 0;
+  if (!(type & CUBEB_DEVICE_TYPE_OUTPUT)) {
+    return CUBEB_OK;
+  }
+
+  cubeb_device_info * dev = calloc(1, sizeof(*dev));
+  if (!dev) {
+    return CUBEB_ERROR;
+  }
+  dev->devid = (cubeb_devid)name;
+  dev->device_id = name;
+  dev->friendly_name = name;
+  dev->group_id = name;
+  dev->vendor_name = NULL;
+  dev->type = CUBEB_DEVICE_TYPE_OUTPUT;
+  dev->state = CUBEB_DEVICE_STATE_ENABLED;
+  dev->preferred = CUBEB_DEVICE_PREF_ALL;
+  dev->format = CUBEB_DEVICE_FMT_S16NE;
+  dev->default_format = CUBEB_DEVICE_FMT_S16NE;
+  dev->max_channels = 2;
+  dev->default_rate = context->info.rate;
+  dev->min_rate = context->info.rate;
+  dev->max_rate = context->info.rate;
+  dev->latency_lo = (uint32_t)(ms_bytes(&context->info, BLEED_LEAD_MIN_MS) /
+                               context->info.frame_bytes);
+  dev->latency_hi = (uint32_t)(ms_bytes(&context->info, BLEED_LEAD_MAX_MS) /
+                               context->info.frame_bytes);
+  collection->device = dev;
+  collection->count = 1;
+  return CUBEB_OK;
+}
+
+static int
+bleed_device_collection_destroy(cubeb * context,
+                                cubeb_device_collection * collection)
+{
+  (void)context;
+  free(collection->device);
+  collection->device = NULL;
+  collection->count = 0;
+  return CUBEB_OK;
+}
+
+static void
+bleed_stream_free(cubeb_stream * stm)
+{
+  if (stm->fd >= 0) {
+    ioctl(stm->fd, AUDIO_IOC_RELEASE, NULL);
+    close(stm->fd);
+  }
+  if (stm->resampler) {
+    cubeb_resampler_destroy(stm->resampler);
+  }
+  free(stm->chunk);
+  pthread_mutex_destroy(&stm->mutex);
+  free(stm);
+}
+
+static int
+bleed_stream_init(cubeb * context, cubeb_stream ** stream,
+                  char const * stream_name, cubeb_devid input_device,
+                  cubeb_stream_params * input_stream_params,
+                  cubeb_devid output_device,
+                  cubeb_stream_params * output_stream_params,
+                  unsigned int latency_frames,
+                  cubeb_data_callback data_callback,
+                  cubeb_state_callback state_callback, void * user_ptr)
+{
+  (void)stream_name;
+  (void)input_device;
+  (void)output_device;
+  (void)latency_frames;
+
+  if (input_stream_params) {
+    return CUBEB_ERROR_NOT_SUPPORTED;
+  }
+  if (!output_stream_params ||
+      (output_stream_params->prefs & CUBEB_STREAM_PREF_LOOPBACK)) {
+    return CUBEB_ERROR_NOT_SUPPORTED;
+  }
+  if (output_stream_params->format != CUBEB_SAMPLE_FLOAT32NE &&
+      output_stream_params->format != CUBEB_SAMPLE_S16NE) {
+    return CUBEB_ERROR_INVALID_FORMAT;
+  }
+  if (output_stream_params->channels < 1 || output_stream_params->channels > 2 ||
+      !output_stream_params->rate) {
+    return CUBEB_ERROR_INVALID_FORMAT;
+  }
+
+  cubeb_stream * stm = calloc(1, sizeof(*stm));
+  if (!stm) {
+    return CUBEB_ERROR;
+  }
+  stm->context = context;
+  stm->user_ptr = user_ptr;
+  stm->data_callback = data_callback;
+  stm->state_callback = state_callback;
+  stm->params = *output_stream_params;
+  stm->volume = 1.0f;
+  stm->fd = -1;
+  pthread_mutex_init(&stm->mutex, NULL);
+
+  stm->fd = open(BLEED_DEVICE, O_WRONLY);
+  if (stm->fd < 0) {
+    bleed_stream_free(stm);
+    return CUBEB_ERROR;
+  }
+  struct audio_map map;
+  if (ioctl(stm->fd, AUDIO_IOC_GET_INFO, &stm->info) < 0 ||
+      ioctl(stm->fd, AUDIO_IOC_ACQUIRE, &map) < 0 || !map.addr) {
+    /* every stream the card can mix is taken */
+    close(stm->fd);
+    stm->fd = -1;
+    bleed_stream_free(stm);
+    return CUBEB_ERROR_DEVICE_UNAVAILABLE;
+  }
+  stm->ring = (uint8_t *)(uintptr_t)map.addr;
+  stm->lead = ms_bytes(&stm->info, BLEED_LEAD_MIN_MS);
+
+  stm->chunk = malloc(BLEED_CHUNK_FRAMES * output_stream_params->channels *
+                      sample_bytes(output_stream_params->format));
+  /* the params say what the card runs at and the rate on its own is the streams, like jack
+   * does it. the same rate both ways is a straight copy through */
+  cubeb_stream_params card = *output_stream_params;
+  card.rate = stm->info.rate;
+  stm->resampler = cubeb_resampler_create(
+      stm, NULL, &card, output_stream_params->rate, data_callback, user_ptr,
+      CUBEB_RESAMPLER_QUALITY_DESKTOP, CUBEB_RESAMPLER_RECLOCK_NONE);
+  if (!stm->chunk || !stm->resampler) {
+    bleed_stream_free(stm);
+    return CUBEB_ERROR;
+  }
+
+  *stream = stm;
+  return CUBEB_OK;
+}
+
+static int
+bleed_stream_start(cubeb_stream * stm)
+{
+  pthread_mutex_lock(&stm->mutex);
+  if (stm->active) {
+    pthread_mutex_unlock(&stm->mutex);
+    return CUBEB_OK;
+  }
+  stm->active = true;
+  pthread_mutex_unlock(&stm->mutex);
+
+  if (pthread_create(&stm->thread, NULL, bleed_thread, stm) != 0) {
+    pthread_mutex_lock(&stm->mutex);
+    stm->active = false;
+    pthread_mutex_unlock(&stm->mutex);
+    return CUBEB_ERROR;
+  }
+  stm->thread_running = true;
+  return CUBEB_OK;
+}
+
+static int
+bleed_stream_stop(cubeb_stream * stm)
+{
+  pthread_mutex_lock(&stm->mutex);
+  bool was = stm->active;
+  stm->active = false;
+  pthread_mutex_unlock(&stm->mutex);
+
+  if (stm->thread_running) {
+    pthread_join(stm->thread, NULL);
+    stm->thread_running = false;
+  }
+
+  /* whatever was queued and not heard is dropped, the next start carries on from what was */
+  pthread_mutex_lock(&stm->mutex);
+  if (stm->card_running) {
+    struct audio_pos pos;
+    if (ioctl(stm->fd, AUDIO_IOC_GET_POS, &pos) == 0) {
+      stm->hw_pos = pos.hw_pos < stm->written ? pos.hw_pos : stm->written;
+    }
+    ioctl(stm->fd, AUDIO_IOC_STOP, NULL);
+    stm->card_running = false;
+  }
+  stm->base_frames += to_stream_frames(stm, stm->hw_pos / stm->info.frame_bytes);
+  stm->written = 0;
+  stm->hw_pos = 0;
+  pthread_mutex_unlock(&stm->mutex);
+
+  if (was) {
+    stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_STOPPED);
+  }
+  return CUBEB_OK;
+}
+
+static void
+bleed_stream_destroy(cubeb_stream * stm)
+{
+  bleed_stream_stop(stm);
+  bleed_stream_free(stm);
+}
+
+static int
+bleed_stream_get_position(cubeb_stream * stm, uint64_t * position)
+{
+  pthread_mutex_lock(&stm->mutex);
+  uint64_t hw = stm->hw_pos;
+  if (stm->card_running) {
+    struct audio_pos pos;
+    if (ioctl(stm->fd, AUDIO_IOC_GET_POS, &pos) == 0) {
+      hw = pos.hw_pos < stm->written ? pos.hw_pos : stm->written;
+      stm->hw_pos = hw;
+    }
+  }
+  *position = stm->base_frames + to_stream_frames(stm, hw / stm->info.frame_bytes);
+  pthread_mutex_unlock(&stm->mutex);
+  return CUBEB_OK;
+}
+
+static int
+bleed_stream_get_latency(cubeb_stream * stm, uint32_t * latency)
+{
+  pthread_mutex_lock(&stm->mutex);
+  uint64_t queued = stm->written > stm->hw_pos ? stm->written - stm->hw_pos : 0;
+  *latency = (uint32_t)to_stream_frames(stm, queued / stm->info.frame_bytes);
+  pthread_mutex_unlock(&stm->mutex);
+  return CUBEB_OK;
+}
+
+static int
+bleed_stream_set_volume(cubeb_stream * stm, float volume)
+{
+  if (volume < 0.0f) {
+    volume = 0.0f;
+  }
+  if (volume > 1.0f) {
+    volume = 1.0f;
+  }
+  pthread_mutex_lock(&stm->mutex);
+  stm->volume = volume;
+  pthread_mutex_unlock(&stm->mutex);
+  return CUBEB_OK;
+}
+
+static struct cubeb_ops const bleed_ops = {
+    .init = bleed_init,
+    .get_backend_id = bleed_get_backend_id,
+    .get_max_channel_count = bleed_get_max_channel_count,
+    .get_min_latency = bleed_get_min_latency,
+    .get_preferred_sample_rate = bleed_get_preferred_sample_rate,
+    .get_supported_input_processing_params = NULL,
+    .enumerate_devices = bleed_enumerate_devices,
+    .device_collection_destroy = bleed_device_collection_destroy,
+    .destroy = bleed_destroy,
+    .stream_init = bleed_stream_init,
+    .stream_destroy = bleed_stream_destroy,
+    .stream_start = bleed_stream_start,
+    .stream_stop = bleed_stream_stop,
+    .stream_get_position = bleed_stream_get_position,
+    .stream_get_latency = bleed_stream_get_latency,
+    .stream_set_volume = bleed_stream_set_volume,
+    .stream_set_name = NULL,
+    .stream_get_current_device = NULL,
+    .stream_set_input_mute = NULL,
+    .stream_set_input_processing_params = NULL,
+    .stream_device_destroy = NULL,
+    .stream_register_device_changed_callback = NULL,
+    .register_device_collection_changed = NULL};
