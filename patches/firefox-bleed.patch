+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "mozilla/CheckedInt.h"
+#include "mozilla/gfx/Types.h"
+#include "nsComponentManagerUtils.h"
+#include "nsIconChannel.h"
+#include "nsIIconURI.h"
+#include "nsIStringStream.h"
+#include "nsMimeTypes.h"
+#include "nsNetUtil.h"
+
+NS_IMPL_ISUPPORTS(nsIconChannel, nsIRequest, nsIChannel)
+
+using namespace mozilla;
+
+// bleed has no icon theme to ask yet, every moz-icon is a plain 9x style page:
+// white with a dark outline and the top right corner folded over
+static void DrawPageIcon(uint8_t* aOut, int aSize) {
+  int fold = aSize / 4;
+  int left = aSize / 8, right = aSize - aSize / 8 - 1;
+  for (int y = 0; y < aSize; y++) {
+    for (int x = 0; x < aSize; x++) {
+      uint8_t* p = aOut + (y * aSize + x) * 4;
+      bool inside = x >= left && x <= right;
+      bool cut = x > right - fold + (y);  // past the folded corner
+      bool edge = x == left || x == right || y == 0 || y == aSize - 1 ||
+                  x == right - fold + y || (y == fold && x >= right - fold);
+      if (!inside || cut) {
+        p[0] = p[1] = p[2] = p[3] = 0;
+      } else if (edge) {
+        p[0] = p[1] = p[2] = 0x40;
+        p[3] = 0xff;
+      } else {
+        p[0] = p[1] = p[2] = 0xff;
+        p[3] = 0xff;
+      }
+    }
+  }
+}
+
+static nsresult moz_icon_to_channel(nsIURI* aURI, nsILoadInfo* aLoadInfo,
+                                    uint32_t aIconSize, nsIChannel** aChannel) {
+  NS_ENSURE_TRUE(aIconSize < 256 && aIconSize > 0, NS_ERROR_UNEXPECTED);
+
+  // two size bytes, the format and a flag byte, then the pixels
+  CheckedInt32 bufSize = 4 + 4 * CheckedInt32(aIconSize) * CheckedInt32(aIconSize);
+  if (!bufSize.isValid()) {
+    return NS_ERROR_OUT_OF_MEMORY;
+  }
+  uint8_t* const buf = (uint8_t*)moz_xmalloc(bufSize.value());
+  buf[0] = aIconSize;
+  buf[1] = aIconSize;
+  buf[2] = uint8_t(gfx::SurfaceFormat::R8G8B8A8);
+  buf[3] = 0xFF;
+  DrawPageIcon(buf + 4, aIconSize);
+
+  nsresult rv;
+  nsCOMPtr<nsIStringInputStream> stream =
+      do_CreateInstance("@mozilla.org/io/string-input-stream;1", &rv);
+  if (NS_FAILED(rv)) {
+    free(buf);
+    return rv;
+  }
+  rv = stream->AdoptData((char*)buf, bufSize.value());
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return NS_NewInputStreamChannelInternal(
+      aChannel, aURI, stream.forget(), nsLiteralCString(IMAGE_ICON_MS),
+      /* aContentCharset */ ""_ns, aLoadInfo);
+}
+
+nsresult nsIconChannel::Init(nsIURI* aURI, nsILoadInfo* aLoadInfo) {
+  nsCOMPtr<nsIMozIconURI> iconURI = do_QueryInterface(aURI);
+  NS_ASSERTION(iconURI, "URI is not an nsIMozIconURI");
+
+  uint32_t desiredImageSize;
+  iconURI->GetImageSize(&desiredImageSize);
+  return moz_icon_to_channel(iconURI, aLoadInfo, desiredImageSize,
+                             getter_AddRefs(mRealChannel));
+}
