+
+// firefox builds with hidden visibility by default, this one comes from libc.so
+#pragma GCC visibility push(default)
+#include <bleed/display.h>
+#pragma GCC visibility pop
+
+using namespace mozilla;
+using namespace mozilla::widget;
+
+// the desktops taskbar along the bottom, windows dont go under it
+static constexpr int32_t kTaskbarHeight = 38;
+
+// one screen the size of the framebuffer
+class DesktopScreenHelper final : public ScreenManager::Helper {
+ public:
+  DesktopScreenHelper() {
+    struct fb_info fb = {};
+    int32_t width = 1366, height = 768;
+    if (get_fb_metadata(&fb) == 0 && fb.width && fb.height) {
+      width = int32_t(fb.width);
+      height = int32_t(fb.height);
+    }
+    LayoutDeviceIntRect rect(0, 0, width, height);
+    LayoutDeviceIntRect avail(0, 0, width, std::max(height - kTaskbarHeight, 1));
+    AutoTArray<RefPtr<Screen>, 1> screens;
+    screens.AppendElement(MakeRefPtr<Screen>(
+        rect, avail, 24, 24, 0, DesktopToLayoutDeviceScale(),
+        CSSToLayoutDeviceScale(), 96.0f, Screen::IsPseudoDisplay::No,
+        Screen::IsHDR::No, 80.0f, 1000.0f));
+    ScreenManager::Refresh(std::move(screens));
+  }
+};
+
+nsAppShell::~nsAppShell() {
+  if (mPipeFDs[0] >= 0) {
+    close(mPipeFDs[0]);
+  }
+  if (mPipeFDs[1] >= 0) {
+    close(mPipeFDs[1]);
+  }
+}
+
+nsresult nsAppShell::Init() {
+  hal::Init();
+
+  if (pipe2(mPipeFDs, O_CLOEXEC | O_NONBLOCK) != 0) {
+    return NS_ERROR_FAILURE;
+  }
+
+  // headless is MOZ_HEADLESS_WIDTH x HEIGHT, otherwise the framebuffer
+  if (XRE_IsParentProcess()) {
+    ScreenManager& screenManager = ScreenManager::GetSingleton();
+    if (gfxPlatform::IsHeadless()) {
+      screenManager.SetHelper(MakeUnique<HeadlessScreenHelper>());
+    } else {
+      screenManager.SetHelper(MakeUnique<DesktopScreenHelper>());
+    }
+  }
+
+  return nsBaseAppShell::Init();
+}
+
+void nsAppShell::ScheduleNativeEventCallback() {
+  unsigned char token = 1;
+  [[maybe_unused]] ssize_t r = write(mPipeFDs[1], &token, 1);
+}
+
+bool nsAppShell::ProcessNextNativeEvent(bool aMayWait) {
+  // the desktops messages come in on the tasks ipc queue, polled with POLL_FD_IPC once
+  // theres a window on it
+  struct pollfd pfd[2] = {{mPipeFDs[0], POLLIN, 0}, {POLL_FD_IPC, POLLIN, 0}};
+  nfds_t count = nsWindow::DesktopActive() ? 2 : 1;
+  int ready;
+  do {
+    ready = poll(pfd, count, aMayWait ? -1 : 0);
+  } while (ready < 0 && errno == EINTR);
+
+  if (ready <= 0) {
+    return false;
+  }
+
+  bool did = false;
+  if (count > 1 && (pfd[1].revents & POLLIN)) {
+    nsWindow::ProcessDesktopEvents();
+    did = true;
+  }
+  if (pfd[0].revents & POLLIN) {
+    // the tokens only mean wake up, gecko works out what to run itself
+    unsigned char buf[64];
+    while (read(mPipeFDs[0], buf, sizeof(buf)) > 0) {
+    }
+    NativeEventCallback();
+    did = true;
+  }
+  return did;
+}
