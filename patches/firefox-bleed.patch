+// bleed has no gpu driver, everything is drawn in software (software webrender, skia).
+// the few features that dont need one stay on
+nsresult GfxInfo::GetFeatureStatusImpl(
+    int32_t aFeature, int32_t* aStatus, nsAString& aSuggestedDriverVersion,
+    const nsTArray<RefPtr<GfxDriverInfo>>& aDriverInfo, nsACString& aFailureId,
+    OperatingSystem* aOS /* = nullptr */) {
+  NS_ENSURE_ARG_POINTER(aStatus);
+  aSuggestedDriverVersion.SetIsVoid(true);
+  if (aOS) {
+    *aOS = OperatingSystem::Linux;
+  }
+
+  switch (aFeature) {
+    case nsIGfxInfo::FEATURE_BACKDROP_FILTER:
+    case nsIGfxInfo::FEATURE_VIDEO_SOFTWARE_OVERLAY:
+      *aStatus = nsIGfxInfo::FEATURE_STATUS_OK;
+      break;
+    default:
+      *aStatus = nsIGfxInfo::FEATURE_BLOCKED_DEVICE;
+      aFailureId = "FEATURE_FAILURE_BLEED_NO_GPU";
+      break;
+  }
+  return NS_OK;
+}
