+nsWindow::nsWindow() = default;
+
+nsWindow::~nsWindow() { Destroy(); }
+
+bool nsWindow::DesktopActive() {
+  return sDesktopWindows && !sDesktopWindows->IsEmpty();
+}
+
+nsresult nsWindow::Create(nsIWidget* aParent, const LayoutDeviceIntRect& aRect,
+                          const widget::InitData& aInitData) {
+  BaseCreate(aParent, aInitData);
+  mBounds = aRect;
+  return NS_OK;
+}
+
+void nsWindow::OpenDesktopWindow() {
+  int32_t width = 0, height = 0;
+  {
+    StaticMutexAutoLock lock(sDesktopLock);
+    if (mDesktop) {
+      return;
+    }
+    NS_ConvertUTF16toUTF8 title(mTitle);
+    mDesktop = cs_window_open_style(mBounds.Width(), mBounds.Height(),
+                                    title.IsEmpty() ? "Firefox" : title.get(),
+                                    mCustomTitlebar ? CS_STYLE_BARE : 0);
+    if (!mDesktop) {
+      // no desktop running, the window carries on like a headless one
+      return;
+    }
+    // firefox maximises its first window on a small screen before its ever shown
+    if (mSizeMode != nsSizeMode_Normal) {
+      cs_window_state(mDesktop, mSizeMode == nsSizeMode_Minimized ? CS_STATE_MINIMISED
+                                                                 : CS_STATE_MAXIMISED);
+    }
+    width = mDesktop->width;
+    height = mDesktop->height;
+  }
+
+  if (!sDesktopWindows) {
+    sDesktopWindows = new nsTArray<nsWindow*>();
+    ClearOnShutdown(&sDesktopWindows);
+  }
+  sDesktopWindows->AppendElement(this);
+
+  // the desktop can give us a different size than we asked for, it caps big windows
+  if (width != mBounds.Width() || height != mBounds.Height()) {
+    ResizeInternal(width, height);
+  }
+}
+
+void nsWindow::CloseDesktopWindow() {
+  {
+    StaticMutexAutoLock lock(sDesktopLock);
+    if (!mDesktop) {
+      return;
+    }
+    cs_window_close(mDesktop);
+    mDesktop = nullptr;
+  }
+  if (sDesktopWindows) {
+    sDesktopWindows->RemoveElement(this);
+  }
+}
+
+void nsWindow::Destroy() {
+  if (mDestroyed) {
+    return;
+  }
+  mDestroyed = true;
+  CloseDesktopWindow();
+  nsIWidget::OnDestroy();
+  nsIWidget::Destroy();
+}
+
+void nsWindow::Show(bool aState) {
+  if (aState == mVisible) {
+    return;
+  }
+  mVisible = aState;
+  if (!IsDesktopWindow()) {
+    return;
+  }
+
+  // the desktop has no hidden windows, so hiding one closes it and showing it opens a new one
+  if (aState) {
+    OpenDesktopWindow();
+    if (mWidgetListener) {
+      mWidgetListener->WindowActivated();
+    }
+  } else {
+    CloseDesktopWindow();
+  }
+}
+
+void nsWindow::Move(const DesktopPoint& aPoint) {
+  // the desktop places windows itself, gecko only gets to know where it thinks they are
+  auto topLeft =
+      LayoutDeviceIntPoint::Round(aPoint * GetDesktopToDeviceScale());
+  if (mBounds.TopLeft() == topLeft) {
+    return;
+  }
+  mBounds.MoveTo(topLeft);
+  NotifyWindowMoved(mBounds.TopLeft());
+}
+
+void nsWindow::Resize(const DesktopSize& aSize, bool aRepaint) {
+  int32_t width = NSToIntRound(aSize.width);
+  int32_t height = NSToIntRound(aSize.height);
+  ConstrainSize(&width, &height);
+  {
+    StaticMutexAutoLock lock(sDesktopLock);
+    if (mDesktop && (width != mDesktop->width || height != mDesktop->height)) {
+      cs_window_resize(mDesktop, width, height);
+    }
+  }
+  ResizeInternal(width, height);
+}
+
+void nsWindow::Resize(const DesktopRect& aRect, bool aRepaint) {
+  Move(aRect.TopLeft());
+  Resize(aRect.Size(), aRepaint);
+}
+
+void nsWindow::ResizeInternal(int32_t aWidth, int32_t aHeight) {
+  if (mBounds.Width() == aWidth && mBounds.Height() == aHeight) {
+    return;
+  }
+  mBounds.SizeTo(LayoutDeviceIntSize(aWidth, aHeight));
+  if (mWidgetListener) {
+    mWidgetListener->WindowResized(this, mBounds.Size());
+  }
+  if (mAttachedWidgetListener) {
+    mAttachedWidgetListener->WindowResized(this, mBounds.Size());
+  }
+}
+
+// the desktop does the minimising and maximising, a CS_EV_STATE says once its happened. its
+// taken as done straight away so the titlebar buttons dont lag behind
+void nsWindow::SetSizeMode(nsSizeMode aMode) {
+  if (aMode == mSizeMode) {
+    return;
+  }
+  {
+    StaticMutexAutoLock lock(sDesktopLock);
+    if (mDesktop) {
+      cs_window_state(mDesktop, aMode == nsSizeMode_Minimized   ? CS_STATE_MINIMISED
+                                : aMode == nsSizeMode_Maximized ? CS_STATE_MAXIMISED
+                                                                : CS_STATE_NORMAL);
+    }
+  }
+  mSizeMode = aMode;
+  if (mWidgetListener) {
+    mWidgetListener->SizeModeChanged(mSizeMode);
+  }
+}
+
+// the taskbar can minimise and restore it, and the desktop maximises a bare window dragged to
+// the top of the screen
+void nsWindow::OnState(int aState) {
+  nsSizeMode mode = aState == CS_STATE_MINIMISED   ? nsSizeMode_Minimized
+                    : aState == CS_STATE_MAXIMISED ? nsSizeMode_Maximized
+                                                   : nsSizeMode_Normal;
+  if (mode == mSizeMode) {
+    return;
+  }
+  mSizeMode = mode;
+  if (mWidgetListener) {
+    mWidgetListener->SizeModeChanged(mSizeMode);
+  }
+}
+
+void nsWindow::SetCustomTitlebar(bool aState) {
+  if (aState == mCustomTitlebar) {
+    return;
+  }
+  mCustomTitlebar = aState;
+  StaticMutexAutoLock lock(sDesktopLock);
+  if (mDesktop) {
+    cs_window_style(mDesktop, aState ? CS_STYLE_BARE : 0);
+  }
+}
+
+void nsWindow::SetFocus(Raise aRaise, mozilla::dom::CallerType aCallerType) {}
+
+nsresult nsWindow::SetTitle(const nsAString& aTitle) {
+  mTitle = aTitle;
+  StaticMutexAutoLock lock(sDesktopLock);
+  if (mDesktop) {
+    cs_window_title(mDesktop, NS_ConvertUTF16toUTF8(aTitle).get());
+  }
+  return NS_OK;
+}
