+LayoutDeviceIntPoint nsWindow::WidgetToScreenOffset() {
+  return mBounds.TopLeft();
+}
+
+// the lock is held from here until EndRemoteDrawingInRegion so a resize cant pull the
+// buffer out from under the frame
+already_AddRefed<DrawTarget> nsWindow::StartRemoteDrawingInRegion(
+    const LayoutDeviceIntRegion& aInvalidRegion) {
+  sDesktopLock.Lock();
+  if (!mDesktop || !mDesktop->pixels || mDesktop->width <= 0 ||
+      mDesktop->height <= 0) {
+    // hidden or already closed, the compositor still finishes its frames. they go
+    // somewhere nobody sees instead of failing and filling the log
+    IntSize size(std::max(mBounds.width, 1), std::max(mBounds.height, 1));
+    if (!mHiddenTarget || mHiddenTarget->GetSize() != size) {
+      mHiddenTarget = Factory::CreateDrawTarget(BackendType::SKIA, size,
+                                                SurfaceFormat::B8G8R8X8);
+    }
+    RefPtr<DrawTarget> hidden = mHiddenTarget;
+    if (!hidden) {
+      sDesktopLock.Unlock();
+    }
+    return hidden.forget();
+  }
+
+  RefPtr<DrawTarget> dt = Factory::CreateDrawTargetForData(
+      BackendType::SKIA, reinterpret_cast<uint8_t*>(mDesktop->pixels),
+      IntSize(mDesktop->width, mDesktop->height), mDesktop->pitch * 4,
+      SurfaceFormat::B8G8R8X8);
+  if (!dt) {
+    sDesktopLock.Unlock();
+    return nullptr;
+  }
+  return dt.forget();
+}
+
+void nsWindow::EndRemoteDrawingInRegion(
+    DrawTarget* aDrawTarget,
+    const LayoutDeviceIntRegion& aInvalidRegion) {
+  if (mDesktop) {
+    LayoutDeviceIntRect r = aInvalidRegion.GetBounds().Intersect(
+        LayoutDeviceIntRect(0, 0, mDesktop->width, mDesktop->height));
+    if (!r.IsEmpty()) {
+      cs_window_commit(mDesktop, r.x, r.y, r.width, r.height);
+    }
+  }
+  sDesktopLock.Unlock();
+}
+
+void nsWindow::ProcessDesktopEvents() {
+  // taken out under the lock and handled after it, handling them runs gecko code that can
+  // wait on the compositor, which needs the lock to draw
+  AutoTArray<cs_event_t, 16> events;
+  {
+    StaticMutexAutoLock lock(sDesktopLock);
+    cs_event_t ev;
+    while (events.Length() < 256 && cs_event_wait(&ev, 0) > 0) {
+      events.AppendElement(ev);
+    }
+  }
+
+  for (const cs_event_t& ev : events) {
+    if (!sDesktopWindows) {
+      return;
+    }
+    RefPtr<nsWindow> target;
+    {
+      StaticMutexAutoLock lock(sDesktopLock);
+      for (nsWindow* w : *sDesktopWindows) {
+        if (w->mDesktop && w->mDesktop->id == ev.window) {
+          target = w;
+          break;
+        }
+      }
+    }
+    if (target && !target->mDestroyed) {
+      target->HandleEvent(ev);
+    }
+  }
+}
+
+void nsWindow::HandleEvent(const cs_event_t& aEvent) {
+  switch (aEvent.type) {
+    case CS_EV_MOUSE:
+      OnMouse(aEvent);
+      break;
+    case CS_EV_WHEEL:
+      OnWheel(aEvent);
+      break;
+    case CS_EV_KEY:
+      OnKey(aEvent);
+      break;
+    case CS_EV_FOCUS:
+      if (mWidgetListener) {
+        if (aEvent.focused) {
+          mWidgetListener->WindowActivated();
+        } else {
+          mWidgetListener->WindowDeactivated();
+        }
+      }
+      break;
+    case CS_EV_CLOSE_REQUEST:
+      if (mWidgetListener) {
+        mWidgetListener->RequestWindowClose(this);
+      }
+      break;
+    case CS_EV_RESIZE:
+      // libcrime already moved over to the new buffer
+      ResizeInternal(aEvent.w, aEvent.h);
+      break;
+    case CS_EV_STATE:
+      OnState(aEvent.x);
+      break;
+    default:
+      break;
+  }
+}
+
+Modifiers nsWindow::CurrentModifiers() const {
+  Modifiers mods = MODIFIER_NONE;
+  if (mKeymod & kModShift) mods |= MODIFIER_SHIFT;
+  if (mKeymod & kModCtrl) mods |= MODIFIER_CONTROL;
+  if (mKeymod & kModAlt) mods |= MODIFIER_ALT;
+  if (mKeymod & kModCaps) mods |= MODIFIER_CAPSLOCK;
+  return mods;
+}
+
+bool nsWindow::DispatchMouse(EventMessage aMessage, int16_t aButton,
+                             uint32_t aClicks) {
+  WidgetMouseEvent event(true, aMessage, this, WidgetMouseEvent::eReal);
+  event.mRefPoint = mPointer;
+  event.mButton = aButton;
+  // the desktops button bits are the same as the dom ones
+  event.mButtons = static_cast<int16_t>(mButtons);
+  event.mClickCount = aClicks;
+  event.mModifiers = CurrentModifiers();
+  event.AssignEventTime(WidgetEventTime());
+  return DispatchInputEvent(&event).mContentStatus ==
+         nsEventStatus_eConsumeNoDefault;
+}
+
+void nsWindow::OnMouse(const cs_event_t& aEvent) {
+  LayoutDeviceIntPoint at(aEvent.x, aEvent.y);
+  if (at != mPointer) {
+    mPointer = at;
+    DispatchMouse(eMouseMove, MouseButton::ePrimary, 0);
+
+    // dragged off the title bar far enough to be a move, the desktop takes it from here and
+    // sends the button up when its let go
+    if (mShouldStartDragging && (aEvent.buttons & CS_BUTTON_LEFT) &&
+        (std::abs(at.x - mDragFrom.x) > kDoubleClickPx ||
+         std::abs(at.y - mDragFrom.y) > kDoubleClickPx)) {
+      mShouldStartDragging = false;
+      StaticMutexAutoLock lock(sDesktopLock);
+      if (mDesktop) {
+        cs_window_move_drag(mDesktop);
+      }
+    }
+  }
+
+  static const struct {
+    uint32_t mBit;
+    int16_t mButton;
+  } kButtons[] = {{CS_BUTTON_LEFT, MouseButton::ePrimary},
+                  {CS_BUTTON_RIGHT, MouseButton::eSecondary},
+                  {CS_BUTTON_MIDDLE, MouseButton::eMiddle}};
+
+  for (const auto& b : kButtons) {
+    bool down = aEvent.buttons & b.mBit;
+    if (down == bool(mButtons & b.mBit)) {
+      continue;
+    }
+
+    if (down) {
+      mButtons |= b.mBit;
+      TimeStamp now = TimeStamp::Now();
+      bool again = mLastClickButton == b.mButton && !mLastClick.IsNull() &&
+                   (now - mLastClick).ToMilliseconds() < kDoubleClickMs &&
+                   std::abs(at.x - mLastClickAt.x) <= kDoubleClickPx &&
+                   std::abs(at.y - mLastClickAt.y) <= kDoubleClickPx;
+      mClickCount = again ? mClickCount + 1 : 1;
+      mLastClick = now;
+      mLastClickAt = at;
+      mLastClickButton = b.mButton;
+      bool taken = DispatchMouse(eMouseDown, b.mButton, mClickCount);
+
+      // the title bar: twice maximises or puts it back, once might be the start of a move
+      if (!taken && !mDestroyed && mCustomTitlebar &&
+          b.mButton == MouseButton::ePrimary && mDraggableRegion.Contains(at)) {
+        if (mClickCount == 2) {
+          SetSizeMode(mSizeMode == nsSizeMode_Maximized ? nsSizeMode_Normal
+                                                        : nsSizeMode_Maximized);
+        } else {
+          mShouldStartDragging = true;
+          mDragFrom = at;
+        }
+      }
+      // the context menu comes on the press like gtk
+      if (b.mButton == MouseButton::eSecondary && !mDestroyed) {
+        DispatchMouse(eContextMenu, b.mButton, mClickCount);
+      }
+    } else {
+      mButtons &= ~b.mBit;
+      if (b.mButton == MouseButton::ePrimary) {
+        mShouldStartDragging = false;
+      }
+      DispatchMouse(eMouseUp, b.mButton, mClickCount);
+    }
+    if (mDestroyed) {
+      return;
+    }
+  }
+}
+
+void nsWindow::OnWheel(const cs_event_t& aEvent) {
+  // a notch away from you is positive and scrolls up, three lines a notch like gtk
+  WidgetWheelEvent event(true, eWheel, this);
+  event.mRefPoint = LayoutDeviceIntPoint(aEvent.x, aEvent.y);
+  event.mDeltaMode = dom::WheelEvent_Binding::DOM_DELTA_LINE;
+  event.mDeltaY = -3.0 * aEvent.wheel;
+  event.mLineOrPageDeltaY = -3 * aEvent.wheel;
+  event.mModifiers = CurrentModifiers();
+  event.AssignEventTime(WidgetEventTime());
+  DispatchInputEvent(&event);
+}
+
+void nsWindow::OnKey(const cs_event_t& aEvent) {
+  mKeymod = aEvent.keymod;
+  const KeyInfo* key = LookupKey(aEvent.keycode);
+  if (!key) {
+    return;
+  }
+
+  bool down = aEvent.key_action != 0;
+  uint8_t slot = aEvent.keycode & 0xFF;
+  WidgetKeyboardEvent event(true, down ? eKeyDown : eKeyUp, this);
+  event.mKeyCode = key->mKeyCode;
+  event.mCodeNameIndex = key->mCode;
+  event.mModifiers = CurrentModifiers();
+  event.mIsRepeat = down && mKeysDown[slot];
+  mKeysDown[slot] = down;
+
+  if (key->mChar) {
+    char c = key->mChar;
+    if (mKeymod & kModShift) {
+      c = key->mShiftChar;
+    } else if ((mKeymod & kModCaps) && c >= 'a' && c <= 'z') {
+      c = c - 'a' + 'A';
+    }
+    event.mKeyNameIndex = KEY_NAME_INDEX_USE_STRING;
+    event.mKeyValue.Assign(char16_t(c));
+  } else {
+    event.mKeyNameIndex = key->mKeyName;
+  }
+  if (key->mCode == CODE_NAME_INDEX_ShiftRight ||
+      key->mCode == CODE_NAME_INDEX_MetaRight) {
+    event.mLocation = dom::KeyboardEvent_Binding::DOM_KEY_LOCATION_RIGHT;
+  } else if (key->mCode == CODE_NAME_INDEX_ShiftLeft ||
+             key->mCode == CODE_NAME_INDEX_ControlLeft ||
+             key->mCode == CODE_NAME_INDEX_AltLeft ||
+             key->mCode == CODE_NAME_INDEX_MetaLeft) {
+    event.mLocation = dom::KeyboardEvent_Binding::DOM_KEY_LOCATION_LEFT;
+  } else if (key->mCode == CODE_NAME_INDEX_NumpadMultiply ||
+             key->mCode == CODE_NAME_INDEX_NumpadSubtract ||
+             key->mCode == CODE_NAME_INDEX_NumpadAdd) {
+    event.mLocation = dom::KeyboardEvent_Binding::DOM_KEY_LOCATION_NUMPAD;
+  }
+  event.AssignEventTime(WidgetEventTime());
+
+  RefPtr<TextEventDispatcher> dispatcher = GetTextEventDispatcher();
+  if (NS_FAILED(dispatcher->BeginNativeInputTransaction())) {
+    return;
+  }
+  nsEventStatus status = nsEventStatus_eIgnore;
+  dispatcher->DispatchKeyboardEvent(event.mMessage, event, status);
+  if (down && !mDestroyed && status != nsEventStatus_eConsumeNoDefault) {
+    dispatcher->MaybeDispatchKeypressEvents(event, status);
+  }
+}
