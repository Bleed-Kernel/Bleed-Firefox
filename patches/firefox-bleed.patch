+    [0x22] = PRINT(G, KeyG, 'g', 'G'),
+    [0x23] = PRINT(H, KeyH, 'h', 'H'),
+    [0x24] = PRINT(J, KeyJ, 'j', 'J'),
+    [0x25] = PRINT(K, KeyK, 'k', 'K'),
+    [0x26] = PRINT(L, KeyL, 'l', 'L'),
+    [0x27] = PRINT(SEMICOLON, Semicolon, ';', ':'),
+    [0x28] = PRINT(QUOTE, Quote, '\'', '@'),
+    [0x29] = PRINT(BACK_QUOTE, Backquote, '`', '~'),
+    [0x2A] = NAMED(SHIFT, Shift, ShiftLeft),
+    [0x2B] = PRINT(BACK_SLASH, Backslash, '\\', '|'),
+    [0x2C] = PRINT(Z, KeyZ, 'z', 'Z'),
+    [0x2D] = PRINT(X, KeyX, 'x', 'X'),
+    [0x2E] = PRINT(C, KeyC, 'c', 'C'),
+    [0x2F] = PRINT(V, KeyV, 'v', 'V'),
+    [0x30] = PRINT(B, KeyB, 'b', 'B'),
+    [0x31] = PRINT(N, KeyN, 'n', 'N'),
+    [0x32] = PRINT(M, KeyM, 'm', 'M'),
+    [0x33] = PRINT(COMMA, Comma, ',', '<'),
+    [0x34] = PRINT(PERIOD, Period, '.', '>'),
+    [0x35] = PRINT(SLASH, Slash, '/', '?'),
+    [0x36] = NAMED(SHIFT, Shift, ShiftRight),
+    [0x37] = PRINT(MULTIPLY, NumpadMultiply, '*', '*'),
+    [0x38] = NAMED(ALT, Alt, AltLeft),
+    [0x39] = PRINT(SPACE, Space, ' ', ' '),
+    [0x3A] = NAMED(CAPS_LOCK, CapsLock, CapsLock),
+    [0x3B] = NAMED(F1, F1, F1),
+    [0x3C] = NAMED(F2, F2, F2),
+    [0x3D] = NAMED(F3, F3, F3),
+    [0x3E] = NAMED(F4, F4, F4),
+    [0x3F] = NAMED(F5, F5, F5),
+    [0x40] = NAMED(F6, F6, F6),
+    [0x41] = NAMED(F7, F7, F7),
+    [0x42] = NAMED(F8, F8, F8),
+    [0x43] = NAMED(F9, F9, F9),
+    [0x44] = NAMED(F10, F10, F10),
+    [0x45] = NAMED(NUM_LOCK, NumLock, NumLock),
+    [0x46] = NAMED(SCROLL_LOCK, ScrollLock, ScrollLock),
+    [0x47] = NAMED(HOME, Home, Home),
+    [0x48] = NAMED(UP, ArrowUp, ArrowUp),
+    [0x49] = NAMED(PAGE_UP, PageUp, PageUp),
+    [0x4A] = PRINT(SUBTRACT, NumpadSubtract, '-', '-'),
+    [0x4B] = NAMED(LEFT, ArrowLeft, ArrowLeft),
+    [0x4D] = NAMED(RIGHT, ArrowRight, ArrowRight),
+    [0x4E] = PRINT(ADD, NumpadAdd, '+', '+'),
+    [0x4F] = NAMED(END, End, End),
+    [0x50] = NAMED(DOWN, ArrowDown, ArrowDown),
+    [0x51] = NAMED(PAGE_DOWN, PageDown, PageDown),
+    [0x52] = NAMED(INSERT, Insert, Insert),
+    [0x53] = NAMED(DELETE, Delete, Delete),
+    [0x56] = PRINT(BACK_SLASH, IntlBackslash, '\\', '|'),
+    [0x57] = NAMED(F11, F11, F11),
+    [0x58] = NAMED(F12, F12, F12),
+    [0x5B] = NAMED(WIN, Meta, MetaLeft),
+    [0x5C] = NAMED(WIN, Meta, MetaRight),
+    [0x5D] = NAMED(CONTEXT_MENU, ContextMenu, ContextMenu),
+};
+
+#undef PRINT
+#undef NAMED
+
+// the tty layer has its own codes for the f keys, 132 is f1
+static const KeyInfo* LookupKey(uint16_t aScancode) {
+  if (aScancode >= 132 && aScancode <= 141) {
+    aScancode = 0x3B + (aScancode - 132);
+  } else if (aScancode == 142 || aScancode == 143) {
+    aScancode = 0x57 + (aScancode - 142);
+  }
+  if (aScancode >= std::size(kKeys) || !kKeys[aScancode].mKeyCode) {
+    return nullptr;
+  }
+  return &kKeys[aScancode];
+}
