+// a window on the crime-scene desktop. top level windows and dialogs get a desktop window
+// of their own with a shared pixel buffer the compositor draws straight into. popups dont
+// have a desktop window yet, they stay invisible like headless ones
+class nsWindow final : public nsIWidget {
+ public:
+  nsWindow();
+
+  NS_INLINE_DECL_REFCOUNTING_INHERITED(nsWindow, nsIWidget)
+
+  // the desktop is talked to from the main thread, events come in through the app shell
+  static bool DesktopActive();
+  static void ProcessDesktopEvents();
+
+  void* GetNativeData(uint32_t aDataType) override { return nullptr; }
+
+  nsresult Create(nsIWidget* aParent, const LayoutDeviceIntRect& aRect,
+                  const widget::InitData&) override;
+  using nsIWidget::Create;
+
+  void Destroy() override;
+  void Show(bool aState) override;
+  bool IsVisible() const override { return mVisible; }
+  void Move(const DesktopPoint&) override;
+  void Resize(const DesktopSize&, bool aRepaint) override;
+  void Resize(const DesktopRect&, bool aRepaint) override;
+  nsSizeMode SizeMode() override { return mSizeMode; }
+  void SetSizeMode(nsSizeMode aMode) override;
+  void Enable(bool aState) override { mEnabled = aState; }
+  bool IsEnabled() const override { return mEnabled; }
+  void SetFocus(Raise, mozilla::dom::CallerType aCallerType) override;
+  // firefox draws its own title bar, the desktop leaves the window bare
+  void SetCustomTitlebar(bool aState) override;
+  void UpdateWindowDraggingRegion(const LayoutDeviceIntRegion& aRegion) override {
+    mDraggableRegion = aRegion;
+  }
+  LayoutDeviceIntRect GetBounds() override { return mBounds; }
+  void Invalidate(const LayoutDeviceIntRect& aRect) override {}
+  nsresult SetTitle(const nsAString& aTitle) override;
+  LayoutDeviceIntPoint WidgetToScreenOffset() override;
+  void SetInputContext(const InputContext& aContext,
+                       const InputContextAction& aAction) override {
+    mInputContext = aContext;
+  }
+  InputContext GetInputContext() override { return mInputContext; }
+  TextEventDispatcherListener* GetNativeTextEventDispatcherListener() override {
+    return DesktopTextListener::Get();
+  }
+
+  // called on the compositors render thread
+  already_AddRefed<gfx::DrawTarget> StartRemoteDrawingInRegion(
+      const LayoutDeviceIntRegion& aInvalidRegion) override
+      MOZ_NO_THREAD_SAFETY_ANALYSIS;
+  void EndRemoteDrawingInRegion(gfx::DrawTarget* aDrawTarget,
+                                const LayoutDeviceIntRegion& aInvalidRegion)
+      override MOZ_NO_THREAD_SAFETY_ANALYSIS;
+
+ private:
+  ~nsWindow();
+
+  bool IsDesktopWindow() const {
+    return mWindowType == WindowType::TopLevel ||
+           mWindowType == WindowType::Dialog;
+  }
+  void OpenDesktopWindow();
+  void CloseDesktopWindow();
+  void ResizeInternal(int32_t aWidth, int32_t aHeight);
+  void HandleEvent(const cs_event_t& aEvent);
+  void OnMouse(const cs_event_t& aEvent);
+  void OnWheel(const cs_event_t& aEvent);
+  void OnKey(const cs_event_t& aEvent);
+  // true if content took it (preventDefault)
+  bool DispatchMouse(EventMessage aMessage, int16_t aButton, uint32_t aClicks);
+  void OnState(int aState);
+  Modifiers CurrentModifiers() const;
+
+  cs_window_t* mDesktop = nullptr;  // only touched under sDesktopLock
+  // what frames draw into while theres no desktop window, also under sDesktopLock
+  RefPtr<gfx::DrawTarget> mHiddenTarget;
+  bool mEnabled = true;
+  bool mVisible = false;
+  bool mDestroyed = false;
+  nsSizeMode mSizeMode = nsSizeMode_Normal;
+  bool mCustomTitlebar = false;
+  // the tab strip and the rest of the title bar, a press there moves the window
+  LayoutDeviceIntRegion mDraggableRegion;
+  bool mShouldStartDragging = false;
+  LayoutDeviceIntPoint mDragFrom;
+  InputContext mInputContext;
+  LayoutDeviceIntRect mBounds;
+  nsString mTitle;
+
+  // what the pointer and keyboard were last time, the desktop sends whole states
+  LayoutDeviceIntPoint mPointer;
+  uint32_t mButtons = 0;
+  uint8_t mKeymod = 0;
+  bool mKeysDown[256] = {};
+  TimeStamp mLastClick;
+  LayoutDeviceIntPoint mLastClickAt;
+  int16_t mLastClickButton = -1;
+  uint32_t mClickCount = 0;
+
+  // libcrime isnt thread safe and a resize swaps the buffer the render thread draws in, so
+  // every libcrime call and every frame happens under this
+  static StaticMutex sDesktopLock;
+};
+
+}  // namespace mozilla::widget
