+
+#include "ft2build.h"
+#include FT_FREETYPE_H
+#include FT_MODULE_H
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+
+static FT_Library gPlatformFTLibrary = nullptr;
+
+gfxBleedPlatform::gfxBleedPlatform() {
+  FT_Init_FreeType(&gPlatformFTLibrary);
+  Factory::SetFTLibrary(gPlatformFTLibrary);
+}
+
+gfxBleedPlatform::~gfxBleedPlatform() {
+  FT_Done_FreeType(gPlatformFTLibrary);
+  gPlatformFTLibrary = nullptr;
+}
+
+already_AddRefed<gfxASurface> gfxBleedPlatform::CreateOffscreenSurface(
+    const IntSize& aSize, gfxImageFormat aFormat) {
+  if (!Factory::AllowedSurfaceSize(aSize)) {
+    return nullptr;
+  }
+  RefPtr<gfxASurface> surface = new gfxImageSurface(aSize, aFormat);
+  return surface.forget();
+}
+
+bool gfxBleedPlatform::CreatePlatformFontList() {
+  return gfxPlatformFontList::Initialize(new gfxFT2FontList);
+}
+
+void gfxBleedPlatform::ReadSystemFontList(
+    mozilla::dom::SystemFontList* aFontList) {
+  gfxFT2FontList::PlatformFontList()->ReadSystemFontList(aFontList);
+}
+
+// whatever is in /usr/share/fonts, wide coverage ones first once theyre shipped
+void gfxBleedPlatform::GetCommonFallbackFonts(
+    uint32_t aCh, Script aRunScript, FontPresentation aPresentation,
+    nsTArray<const char*>& aFontList) {
+  if (PrefersColor(aPresentation)) {
+    aFontList.AppendElement("Noto Color Emoji");
+  }
+  aFontList.AppendElement("DejaVu Sans");
+  aFontList.AppendElement("Noto Sans");
+  aFontList.AppendElement("Barlow");
+  aFontList.AppendElement("JetBrains Mono");
+}
+
+// no vblank from the display yet, a timer it is
+already_AddRefed<mozilla::gfx::VsyncSource>
+gfxBleedPlatform::CreateGlobalHardwareVsyncSource() {
+  return GetSoftwareVsyncSource();
+}
